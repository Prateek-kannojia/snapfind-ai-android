<?xml version="1.0" encoding="utf-8"?><!--
   Pre Android 12 full backup rules. Same exclusions and same reasoning as
   data_extraction_rules.xml, which covers API 31 and above: face photos and
   the match database stay on the device, and a 25MB backup quota must not be
   allowed to restore a database whose photos were dropped.
-->
<full-backup-content>
    <exclude domain="database" path="snapfind.db" />
    <exclude domain="file" path="saved_matches" />
    <exclude domain="file" path="job_work" />
    <exclude domain="file" path="facesdk_models" />
</full-backup-content>
