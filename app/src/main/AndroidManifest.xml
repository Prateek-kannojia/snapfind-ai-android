<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SnapFindApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SnapFindAI">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SnapFindAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Step 1 of the on-device plan: throwaway per-photo timing spike.
          Not linked from MainActivity's nav graph. Launch it directly:
            adb shell am start -n com.example.snapfindai/.spike.TimingSpikeActivity
          Delete this activity + the spike/ package once the timing question is answered.
        -->
        <activity
            android:name=".spike.TimingSpikeActivity"
            android:exported="true"
            android:label="Timing Spike"
            android:theme="@style/Theme.SnapFindAI" />
    </application>

</manifest>
