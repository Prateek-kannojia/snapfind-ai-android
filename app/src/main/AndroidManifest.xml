<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only needed to save photos to the gallery on Android 9 (API 28) and
         below. Android 10+ inserts into MediaStore without this permission
         at all (scoped storage). maxSdkVersion means it's simply not
         requested on newer OS versions. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Android 13+ (API 33) requires this to show any notification at all,
         including the download-progress/completed one. Harmless to declare
         on older versions: it's simply not a runtime permission there. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SnapFindApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SnapFindAI">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SnapFindAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Step 1 of the on-device plan: throwaway per-photo timing spike.
          Not linked from MainActivity's nav graph. Launch it directly:
            adb shell am start -n com.example.snapfindai/.spike.TimingSpikeActivity
          Delete this activity + the spike/ package once the timing question is answered.
        -->
        <activity
            android:name=".spike.TimingSpikeActivity"
            android:exported="true"
            android:label="Timing Spike"
            android:theme="@style/Theme.SnapFindAI" />
    </application>

</manifest>
