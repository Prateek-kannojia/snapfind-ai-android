local.properties

# Model weights for facecore — not committed, same as how the backend never
# commits downloaded model weights. Every build fetches them at runtime via
# ModelDownloader, so they are never bundled into a shipped APK.
# Hosted as a GitHub Release asset (see ModelConfig).
facecore/src/debug/assets/models/

# adb-pulled measurement output -- regenerate locally, never commit.
/*.csv

# Private release-prep notes: account state, store-listing drafts and the
# order things get submitted in. Useful locally, not part of the project's
# public story.
/PLAY_STORE_LAUNCH_CHECKLIST.md

# Signing material for the Play upload key. The keystore itself is the one
# file in this project that cannot be regenerated, and the properties file
# holds its passwords in plain text — neither ever goes to a remote.
*.jks
*.keystore
/keystore.properties
/signing.properties
